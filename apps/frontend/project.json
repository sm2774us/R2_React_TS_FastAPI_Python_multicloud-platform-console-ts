{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "targets": {
    "dev": { "executor": "nx:run-commands", "options": { "command": "vite", "cwd": "apps/frontend" } },
    "build": { "executor": "nx:run-commands", "options": { "command": "vite build", "cwd": "apps/frontend" }, "outputs": ["{projectRoot}/dist"] },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint src --ext .ts,.tsx", "cwd": "apps/frontend" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "vitest run", "cwd": "apps/frontend" } }
  }
}
